# Optional shared key. When set, every /api/v1/* request must send X-API-Key.
API_KEY=

DATASET_CACHE_TTL_SECONDS=300
DETAIL_CACHE_TTL_SECONDS=120
ENERGY_CACHE_TTL_SECONDS=120
PORTAL_REQUEST_TIMEOUT_SECONDS=20
PORTAL_MAX_RETRIES=2
LOG_LEVEL=INFO
