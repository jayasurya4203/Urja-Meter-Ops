# Copy to .env and adjust. These are the sandbox credentials supplied with the
# take-home; replace them for any real deployment.
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_EMAIL=operator@urja.local
PORTAL_PASSWORD=urja-ops-2026
